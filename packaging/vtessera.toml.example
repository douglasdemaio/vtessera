# Vtessera metering daemon configuration
#
# Copy this to /etc/vtessera/vtessera.toml and adjust.

# How often to sample resource usage (seconds, 1–3600)
sample_interval_secs = 60

# Directory for storing signed usage receipts
state_dir = "/var/lib/vtessera"

# Path to the Ed25519 identity key (auto-generated if missing)
#
# Lives in the state directory, not /etc: the hardened systemd unit
# (ProtectSystem=strict + DynamicUser, see packaging/vtesserad.service)
# makes /etc read-only and unprivileged, so a key in /etc can never be
# written — nor a root-created one read. `StateDirectory=vtessera`
# instead creates /var/lib/vtessera owned by the service's dynamic user,
# so the daemon can generate and hold its key there on first start.
key_path = "/var/lib/vtessera/identity.key"

# Operator payout identifier. Must be a Solana base58 Ed25519 public key
# (32–44 characters from the base58 alphabet). Required only when
# `mode = "paid"` (the default). In free/donate mode it may be empty.
# Example below is a well-known throwaway address; REPLACE before production.
payout_id = "9WzDXwBbmkg8ZTbNMqUxvQRAyrZzDsGYdLVL9zYtAWWM"

# How this node prices its compute:
#   mode     = "paid" | "free"   — sell compute, or donate it (no payout
#                                  address or price required).
#   currency = "eurc" | "usdc"   — what a paid node quotes in.
#   price_per_cpu_hour = 0.05    — price per CPU-hour as a decimal, e.g.
#                                  €0.05 / CPU-hour. Informational in v0;
#                                  the offer builder converts it to
#                                  per_device_second_micros.
# mode = "paid"
# currency = "eurc"
# price_per_cpu_hour = 0.05

# Number of samples per receipt window (optional, default 60)
# window_size = 60

# Cap on retained receipt files in `state_dir`. Unset means unlimited
# (the daemon never deletes anything — v0 default). For long-running
# deployments set this so the spool can't grow without bound. The
# rotator deletes only files matching `receipt_*.json`; anything else
# in the directory is left alone.
# max_spool_files = 10000

# Resource capacity caps (optional, used for pricing hints)
[resource_caps]
max_cpus = 8
max_mem_kb = 16777216   # 16 GB
max_disk_kb = 524288000 # 500 GB

# Submit endpoint — only used when built with --features submit
# submit_endpoint = "https://api.vtessera.example/receipts"
